{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "yoloMode": false,
  "permission": {
    "*": "ask",
    "third_party_tool": "ask",
    "web_fetch": "allow",
    "mcp": "allow",
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/projects/*": "allow",
      "~/.supacode/repos/*": "allow",
      "/tmp/*": "allow"
    },
    "external_directory_read": {
      "~/.gem/*": "allow",
      "~/.local/share/mise/*": "allow",
      "~/.agents/*": "allow",
      "~/.pi/agent/extensions/pi-permission-system/config.json": "allow"
    },
    "plannotator_submit_plan": "allow",
    "mcp__rollbar": "allow",
    "bash": {
      "*": "ask",
      "git log *": "allow",
      "git diff *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git reflog *": "allow",
      "git show *": "allow",
      "git stash *": "allow",
      "git rebase --continue *": "allow",
      "git checkout *": "allow",
      "git branch *": "allow",
      "git status *": "allow",
      "git config --get *": "allow",
      "git blame *": "allow",
      "git rev-parse *": "allow",
      "git merge-base *": "allow",
      "git fetch *": "allow",
      "gh issue list": "allow",
      "gh issue view *": "allow",
      "gh run view *": "allow",
      "gh pr list": "allow",
      "gh pr view *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "ls *": "allow",
      "cd *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "find *": "allow",
      "cat *": "allow",
      "readlink *": "allow",
      "nl *": "allow",
      "wc *": "allow",
      "cut *": "allow",
      "awk *": "allow",
      "sed *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "npx jest *": "allow",
      "npx tsc *": "allow",
      "script/test *": "allow",
      "script/lint *": "allow",
      "make karma_ci": "allow",
      "rake format:*": "allow",
      "bin/rubocop *": "allow",
      "bin/brakeman *": "allow",
      "*bundle exec rubocop *": "allow",
      "*bundle exec brakeman *": "allow",
      "*bundle exec rake format:*": "allow",
      "*rails test *": "allow",
      "*rails test:*": "allow",
      "npm run build:css": "allow",
      "npm audit *": "allow",
      "bundle list": "allow",
      "true": "allow",
      "pwd": "allow",
      "pnpm run check-typescript": "allow",
      "xargs grep *": "allow"
    }
  }
}
