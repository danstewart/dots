{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "yoloMode": false,
  "permission": {
    "*": "ask",
    "skill": {
      "*": "ask",
      "local-review": "allow"
    },
    "mcp": {
      "*": "ask",
      "mcp_stat": "allow",
      "mcp_list": "allow",
      "rollbar:get-item-details": "allow",
      "rollbar:get-deployments": "allow",
      "rollbar:get-version": "allow",
      "rollbar:list-items": "allow",
      "rollbar:list-projects": "allow",
      "rollbar:list-occurrences": "allow"
    },
    "third_party_tool": "ask",
    "web_fetch": "allow",
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/projects/*": "allow",
      "~/.supacode/repos/*": "allow",
      "/tmp/*": "allow"
    },
    "external_directory_read": {
      "~/.gem/*": "allow",
      "~/.local/share/mise/*": "allow",
      "~/.agents/*": "allow",
      "/private/tmp/*": "allow",
      "~/.pi/agent/extensions/pi-permission-system/config.json": "allow",
      "~/Data/Notes/*": "allow"
    },
    "plannotator_submit_plan": "allow",
    "bash": {
      "*": "ask",
      "xargs grep *": "allow",
      "xargs rg *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git diff-tree *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git reflog *": "allow",
      "git show *": "allow",
      "git stash *": "allow",
      "git rebase --continue *": "allow",
      "git checkout *": "allow",
      "git branch *": "allow",
      "git status *": "allow",
      "git config --get *": "allow",
      "git blame *": "allow",
      "git rev-parse *": "allow",
      "git merge-base *": "allow",
      "git fetch *": "allow",
      "gh issue list": "allow",
      "gh issue view *": "allow",
      "gh run view *": "allow",
      "gh pr list": "allow",
      "gh pr view *": "allow",
      "gh pr diff *": "allow",
      "gh project item-list *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "xxd *": "allow",
      "date *": "allow",
      "stat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "ls *": "allow",
      "cd *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "find *": "allow",
      "cat *": "allow",
      "tr *": "allow",
      "readlink *": "allow",
      "nl *": "allow",
      "ps *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "cut *": "allow",
      "awk *": "allow",
      "sed *": "allow",
      "sort *": "allow",
      "diff *": "allow",
      "uniq *": "allow",
      "mkdir *": "allow",
      "npx jest *": "allow",
      "npx pretty-quick *": "allow",
      "pnpm exec jest *": "allow",
      "npx tsc *": "allow",
      "npx prettier *": "allow",
      "node_modules/.bin/prettier": "allow",
      "node_modules/.bin/eslint": "allow",
      ".venv/bin/ruff *": "allow",
      "script/test *": "allow",
      "./script/test *": "allow",
      "script/codegen *": "allow",
      "./script/codegen *": "allow",
      "script/lint *": "allow",
      "./script/lint *": "allow",
      "make karma_ci": "allow",
      "rake format:*": "allow",
      "bin/rubocop *": "allow",
      "bin/brakeman *": "allow",
      "bin/importmap *": "allow",
      "*bundle exec rubocop *": "allow",
      "*bundle exec brakeman *": "allow",
      "*bundle exec rake format:*": "allow",
      "*rails test *": "allow",
      "*rails test:*": "allow",
      "npm run build:css": "allow",
      "npm audit *": "allow",
      "bundle list": "allow",
      "true": "allow",
      "pwd": "allow",
      "pnpm run check-typescript": "allow",
      "pnpm run lint:*": "allow",
      "pnpm exec eslint *": "allow",
      "pnpm exec prettier *": "allow",
      "npx eslint *": "allow",
      "node --check *": "allow"
    }
  }
}
