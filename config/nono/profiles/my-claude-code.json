{
	"meta": {
		"name": "my-claude-code",
		"version": "1.0.0",
		"description": "Claude Code with additional project access"
	},
	"extends": "claude-code",
	"groups": {
		"include": []
	},
	"filesystem": {
		"allow": ["$WORKDIR", "$HOME/.claude", "$HOME/projects", "$HOME/.npm", "$HOME/.cache"]
	},
	"network": {
		"block": false
	},
	"env_credentials": {}
}
