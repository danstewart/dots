// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
	{
		"context": "Workspace",
		"bindings": {
			"shift shift": "file_finder::Toggle",
			"cmd-t": "project_panel::Toggle",
			"cmd-b": "agent::Toggle",
		},
	},
	{
		// Always have tab use AI predicatiosn even if autocomplete box is open
		"context": "Editor && (edit_prediction && showing_completions)",
		"bindings": {
			"tab": "editor::AcceptEditPrediction",
		},
	},
	{
		// By default cmd+f doesn't allow using `n` to go to next match
		// so use the vim search instead
		"context": "Editor && mode == full",
		"bindings": {
			"cmd-f": "vim::Search",
		},
	},
	{
		"context": "Terminal",
		"bindings": {
			"cmd-c": ["terminal::SendKeystroke", "ctrl-c"],
			"cmd-shift-c": "terminal::Copy",
		},
	},
	{
		"context": "Editor && vim_mode == insert && mode == full",
		"bindings": {
			"ctrl-a": "vim::StartOfLine",
			"ctrl-e": "vim::EndOfLine",
		},
	},
	{
		"context": "Editor && vim_mode == normal && mode == full",
		"bindings": {
			"cmd-c": "editor::ToggleComments",
			"ctrl-a": "vim::StartOfLine",
			"ctrl-e": "vim::EndOfLine",
			"tab": "vim::Indent",
			"shift-tab": "vim::Outdent",
			"cmd-o": ["vim::Literal", ["ctrl-o", "\u000f"]],
			"cmd-i": ["vim::Literal", ["ctrl-i", "\t"]],
			"Y": "vim::YankToEndOfLine",
			// This allows the WhichKey menu to stay active for longer
			"space": null,
			// test:single
			"space t s": ["task::Spawn", { "task_name": "pytest_single", "reevaluate_context": true }],
			// test:all
			"space t a": ["task::Spawn", { "task_name": "pytest_current", "reevaluate_context": true }],
			// debug:start
			"space d s": "debugger::Start",
			// debug:restart
			"space d r": ["action::Sequence", ["debugger::Stop", "debugger::Rerun"]],
		},
	},
	{
		"context": "Editor && vim_mode == visual && mode == full",
		"bindings": {
			"cmd-c": "editor::ToggleComments",
			"tab": "vim::Indent",
			"shift-tab": "vim::Outdent",
		},
	},
	{
		"context": "Editor && (edit_prediction && (showing_completions || in_leading_whitespace))",
		"bindings": {
			"tab": "editor::AcceptEditPrediction",
		},
	},
]
