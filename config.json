# This file has a list of tags and the files they should link
# The key is the source file within /config and the value is either the target to link
# or an object
#
# Tags can include other tags by having "&include": [ "otherTag" ]
# $HOME will automatically be replaced
#
# If the file maps to an object then you can specify
# - src: The path of the src file (Defaults to the key if not specified)
# - target: The target to link to
# - andThen: Optional shell command to run after linking
# - cond: Optional shell condition (automatically wrapped in [])
# - noForce: Overrides --force flag to never overwrite
#
# A lot of the below config is overcomplicated and unneccessary - just to use as an example
{
  # Individual groups
  "bash": {
    "bash/bashrc": "$HOME/.bashrc",
    "bash/bash_aliases": "$HOME/.bash_aliases",
    "bash/sensible.bash": "$HOME/.sensible.bash",
  },
  "nvim": {
    "vim/nvim-init.vim": "$HOME/.config/nvim/init.vim",
  },
  "ssh": {
    "ssh/config": {
      "target": "$HOME/.ssh/config",
      "andThen": "chmod 600 $HOME/.ssh/config",
    },
  },
  "sshKeys": {
    # Copy ssh key from Nextcloud
    "sshkey": {
      "src": "$HOME/Nextcloud/Keys/ssh/id_rsa",
      "target": "$HOME/.ssh/id_rsa",
      "cond": "-e $HOME/Nextcloud/",
      "noForce": true,
      "andThen": "chmod 600 $HOME/.ssh/id_rsa",
    },
    "sshpubkey": {
      "src": "$HOME/Nextcloud/Keys/ssh/id_rsa.pub",
      "target": "$HOME/.ssh/id_rsa.pub",
      "cond": "-e $HOME/Nextcloud/",
      "noForce": true,
      "andThen": "chmod 600 $HOME/.ssh/id_rsa.pub",
    },
  },
  "pi": {
    "pi/agent/extensions/pi-permission-system/config.json": "$HOME/.pi/agent/extensions/pi-permission-system/config.json",
    "pi/agent/extensions/pi-permission-classifier/config.json": "$HOME/.pi/agent/extensions/pi-permission-classifier/config.json",
    "pi/agent/extensions/pi-permission-classifier/Modelfile.judge": {
      "target": "$HOME/.pi/agent/extensions/pi-permission-classifier/Modelfile.judge",
      # Local judge model for the permission classifier. Needs `ollama pull qwen3:4b-instruct` first.
      "cond": "-x $(command -v ollama)",
      "andThen": "ollama create qwen3-judge -f $HOME/.pi/agent/extensions/pi-permission-classifier/Modelfile.judge",
    },
    "pi/agent/models.json": "$HOME/.pi/agent/models.json",
    "pi/agent/AGENTS.md": "$HOME/.pi/agent/AGENTS.md",
    "pi/agent/settings.json": "$HOME/.pi/agent/settings.json",
    "pi/agent/keybindings.json": "$HOME/.pi/agent/keybindings.json",
    "pi/agent/open-tui.json": "$HOME/.pi/agent/open-tui.json",
    "pi/agent/.i-have-adhd-always": "$HOME/.pi/agent/.i-have-adhd-always",
    "pi/AGENT.md": "$HOME/.pi/AGENT.md",
  },
  "skills": {
    "agents/skills/local-review": "$HOME/.agents/skills/local-review",
    "agents/skills/daily-summary": "$HOME/.agents/skills/daily-summary",
    "agents/skills/audit-tests": "$HOME/.agents/skills/audit-tests"
  },
  # Mac development machine
  "mac": {
    "&include": ["bash", "ssh", "pi", "skills"],
    "gitconfig": "$HOME/.gitconfig",
    "litecli.ini": "$HOME/.config/litecli/config",
    "scripts": "$HOME/scripts",
    "dircolors": "$HOME/.dircolors",
    "prettierrc": "$HOME/.prettierrc",
    "vim/simplevimrc": "$HOME/.vimrc",
    "ghostty/config": "$HOME/Library/Application Support/com.mitchellh.ghostty/config.ghostty",
    "mori/ghostty.config": "$HOME/.config/ghostty/config",
    "tuicr/config.toml": "$HOME/.config/tuicr/config.toml",
  },
  # Work mac machine
  "work-mac": {
    "&include": ["pi", "skills"],
    "gitconfig": "$HOME/.gitconfig",
    "scripts": "$HOME/scripts",
    "vim/simplevimrc": "$HOME/.vimrc",
    "ghostty/config": "$HOME/Library/Application Support/com.mitchellh.ghostty/config.ghostty",
    "mori/ghostty.config": "$HOME/.config/ghostty/config",
    "tuicr/config.toml": "$HOME/.config/tuicr/config.toml",
  },
  # Server includes only bash and vimrc
  "server": {
    "&include": ["bash"],
    "vim/simplevimrc": "$HOME/.vimrc",
  },
}
